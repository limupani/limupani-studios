# Copy this file to ".env" and fill it in. Never commit ".env" (it holds secrets).

# Port the API listens on
PORT=4000

# Your database. For local testing with your own Postgres:
#   postgresql://USER:PASSWORD@localhost:5432/DATABASE
# For Supabase use the "Session pooler" string (Dashboard -> Connect), which looks like:
#   postgres://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# On Vercel use the "Transaction pooler" string instead (same, but port 6543).
DATABASE_URL=

# Only for Vercel: connections each copy of the server may open (leave out locally)
# DB_POOL_MAX=1

# Websites allowed to call this API (comma-separated). Add your real domain when you deploy.
CORS_ORIGINS=http://localhost:5173
